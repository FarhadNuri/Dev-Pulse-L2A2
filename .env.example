# ==============================================================================
# DevPulse Server Environment Configuration
# ==============================================================================

# Server port (default: 5000)
PORT=5000

# PostgreSQL connection string (e.g. Neon cloud database or local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_nD72XmtjiCFd@ep-solitary-shape-apx7fmgh-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT secret key for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# JWT token expiration time (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Salt rounds for bcrypt password hashing
BCRYPT_SALT_ROUNDS=10

# Allowed frontend origin for CORS (e.g. http://localhost:5173 or production domain)
FRONTEND_URL=http://localhost:5173

# Application base URL for invitation links (e.g. http://localhost:5173)
APP_URL=http://localhost:5173

# Resend API key for sending emails (leave empty in local dev to log emails to console)
RESEND_API_KEY=

# Sender email address
EMAIL_FROM=DevPulse <noreply@devpulse.app>


